# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Booking link for "Book a Consultation" (Calendly, Cal.com, etc.). Falls back to the contact form if unset.
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/your-handle/your-event

# Optional public contact details (hidden when empty)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives contact-form inquiries and newsletter sign-ups
CONTACT_TO_EMAIL=
# Verified sender, e.g. "DevFlowX <hello@your-domain.com>". Defaults to Resend's onboarding sender for testing.
RESEND_FROM_EMAIL=


#Upstash Redis Credentials for DevFLowX analytics
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
#
# SEO: paste the verification codes from Google Search Console / Bing Webmaster Tools (optional)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- Daily visitor report ---
# Secret that protects /api/cron/daily-report. Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
# Generate one with: openssl rand -hex 32
CRON_SECRET=
# Recipient(s) of the daily report (comma-separated)
REPORT_TO_EMAIL=ahmadcancerian3@gmail.com
# Optional: report cut-off time and timezone (defaults: 11:45 at UTC+5). Keep vercel.json cron (UTC) in sync.
# REPORT_HOUR=11
# REPORT_MINUTE=45
# REPORT_TZ_OFFSET_MINUTES=300
# REPORT_TZ_LABEL=PKT
